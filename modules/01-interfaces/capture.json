{
  "outputs": {
    "go-demo":   { "dir": "go",   "cmd": ["go", "run", "./cmd/demo"], "showCmd": true },
    "rust-demo": { "dir": "rust", "cmd": ["cargo", "run", "--quiet", "--bin", "demo"], "showCmd": true },
    "ocaml-demo": { "dir": "ocaml", "cmd": ["dune", "exec", "bin/main.exe"], "showCmd": true },
    "swift-demo": { "cmd": ["bash", "../../scripts/run-swift.sh", "swift"] },
    "kotlin-demo": { "cmd": ["bash", "../../scripts/run-kotlin.sh", "kotlin"] },

    "go-devirt": {
      "dir": "go",
      "cmd": ["bash", "-c", "go build -gcflags=-m ./... 2>&1 | grep -E 'devirtualizing|inlining call to (shapes\\.)?Circle.Area' | grep -v autogenerated"],
      "showCmd": false,
      "portable": false
    },
    "rust-orphan-error": {
      "dir": "reject-orphan",
      "cmd": ["bash", "-c", "cargo build 2>&1 | grep -E 'E0117|orphan|only traits' | head -3"],
      "allowError": true,
      "portable": false,
      "normalize": ["path"]
    }
  },
  "snippets": {
    "go-iface":   { "file": "go/shapes.go",                          "region": "iface" },
    "rust-trait": { "file": "rust/src/lib.rs",                       "region": "trait" },
    "ocaml-obj":  { "file": "ocaml/lib/shapes.ml",                   "region": "obj" },
    "swift-proto": { "file": "swift/Sources/Shapes/Shapes.swift",    "region": "proto" },
    "kotlin-iface": { "file": "kotlin/lib/Shapes.kt",                "region": "iface" }
  },
  "files": {
    "go-bench": { "file": "go/bench.txt", "portable": false }
  }
}
