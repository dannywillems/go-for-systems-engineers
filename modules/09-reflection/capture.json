{
  "outputs": {
    "go-demo":    { "dir": "go",    "cmd": ["go", "run", "./cmd/demo"], "showCmd": true },
    "rust-demo":  { "dir": "rust",  "cmd": ["cargo", "run", "--quiet", "--bin", "demo"], "showCmd": true },
    "ocaml-demo": { "dir": "ocaml", "cmd": ["dune", "exec", "bin/main.exe"], "showCmd": true },
    "swift-demo": { "cmd": ["bash", "../../scripts/run-swift.sh", "swift"] },
    "kotlin-demo": { "cmd": ["bash", "../../scripts/run-kotlin.sh", "kotlin"] },

    "go-reject": {
      "dir": "reject-structtag",
      "cmd": ["bash", "-c", "go vet ./... 2>&1 | grep -i 'struct field tag' | head -1"],
      "allowError": true, "portable": false, "normalize": ["path"]
    },
    "rust-reject": {
      "dir": "reject-rust",
      "cmd": ["bash", "-c", "cargo build 2>&1 | grep -E 'E0277' | head -1"],
      "allowError": true, "portable": false, "normalize": ["path"]
    },
    "swift-reject": {
      "dir": "reject-swift",
      "cmd": ["bash", "-c", "swiftc -typecheck reject.swift 2>&1 | grep -i 'does not conform' | head -1"],
      "allowError": true, "portable": false, "normalize": ["path"]
    },
    "kotlin-reject": {
      "dir": "reject-kotlin",
      "cmd": ["bash", "-c", "kotlinc reject.kt -include-runtime -d /tmp/rk9.jar 2>&1 | grep -i 'primary constructor' | head -1"],
      "allowError": true, "portable": false, "normalize": ["path"]
    }
  },
  "snippets": {
    "go-tags":     { "file": "go/person.go",     "region": "tags" },
    "go-reflect":  { "file": "go/describe.go",   "region": "reflect" },
    "rust-derive": { "file": "rust/src/lib.rs",  "region": "derive" }
  },
  "files": {
    "measured": { "file": "measured.txt", "portable": false }
  }
}
